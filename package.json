{
  "name": "battlechess",
  "version": "0.1.0",
  "private": true,
  "description": "3D online/AI chess where captured pieces come to life and fight.",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "start": "node server/dist/server/src/index.js",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "concurrently": "^9.1.0",
    "meshoptimizer": "^1.2.0"
  }
}
